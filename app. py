import gradio as gr, base64
from openai import OpenAI
client = OpenAI(base_url="https://openrouter.ai/api/v1", api_key="YOUR_KEY")
prompt = "Is Indian thali mein har item pehchano. Table do: item, approx quantity, calories, protein(g), price in INR. Last mein total calories aur 1 health tip."
def scan(path): return client.chat.completions.create(model="meta-llama/llama-4-scout", messages=[{"role": "user", "content": [{"type": "text", "text": prompt}, {"type": "image_url", "image_url": {"url": "data:image/jpeg;base64," + base64.b64encode(open(path, "rb").read()).decode()}}]}]).choices[0].message.content
demo = gr.Interface(fn=scan, inputs=gr.Image(type="filepath", label="Thali photo"), outputs=gr.Markdown(), title="ThaliScan")
demo.launch(share=True)
